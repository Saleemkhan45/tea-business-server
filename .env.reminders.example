# Review-only example. Never copy real secrets into React or source control.
# Disabled unless separately approved; dry_run still requires approved DB/index setup.
REMINDER_WORKER_ENABLED=false
REMINDER_DELIVERY_MODE=dry_run
# 64 hexadecimal characters generated securely outside source control.
REMINDER_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Explicit currently-supported provider version, for example vXX.X (no implicit version).
WHATSAPP_API_VERSION=
# Approved privacy-minimized template with no body parameters.
WHATSAPP_OPERATOR_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# JSON mapping real shop IDs to independently verified, opted-in operator E.164 numbers.
# Leave empty until setup and recipient approval are complete.
WHATSAPP_APPROVED_OPERATORS={}
# Customer-facing messaging is separate from operator delivery. Explicitly bind
# this deployment's sender to one shop before accepting customer conversations.
WHATSAPP_CUSTOMER_ENABLED=false
WHATSAPP_CUSTOMER_SHOP_ID=
WHATSAPP_SENDER_NUMBER=
# Approved BODY parameters, in order: customer name, expected whole-PKR amount.
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_MESSAGE_RETENTION_DAYS=90
# Enable only after reviewed schema/index deployment. Keep cleanup enabled even
# when customer delivery is later disabled, to remove expired encrypted bodies.
WHATSAPP_RETENTION_ENABLED=false
