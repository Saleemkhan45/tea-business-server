{
  "name": "tea-wholesale-dashboard-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "security:email:check": "node scripts/checkSecurityEmail.js",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "test": "vitest run",
    "test:integration": "vitest run services/saleService.integration.test.js --reporter=verbose",
    "reminders:run": "node reminders/run.js",
    "test:db:up": "docker compose -f ../compose.test.yaml up -d --wait --wait-timeout 120",
    "test:db:down": "docker compose -f ../compose.test.yaml down",
    "seed:notifications": "node seed/notificationSeed.js",
    "trigger:notification": "node scripts/triggerNotification.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ldrs": "^1.1.9",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
