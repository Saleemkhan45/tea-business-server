NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tea_business_dashboard
JWT_SECRET=<generate-with-crypto-randomBytes>
CLIENT_ORIGIN=http://localhost:5173
SESSION_COOKIE_SAMESITE=lax
# Explicit trusted-device opt-in at login; existing sessions keep their original expiry.
SESSION_SHORT_HOURS=8
SESSION_SLIDING_DAYS=30
SESSION_ABSOLUTE_DAYS=180
SESSION_RENEWAL_HOURS=24
# Account verification delivery via Resend. Guide: ../docs/email-delivery-setup.md
# Create a sending API key and verify your sending domain in Resend first.
# Keep credentials backend-only; never use a VITE_ variable for these values.
# Enable after configuration review; configured does not mean inbox delivery is proven.
SECURITY_EMAIL_ENABLED=false
RESEND_API_KEY=
# Example only: Tea Business <security@your-verified-domain>
SECURITY_EMAIL_FROM=
CASH_BOOK_ENABLED=false
